<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large"
    tools:context=".ui.MainActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/TextStyle.Title"
        android:layout_marginBottom="@dimen/spacing_large" />

    <!-- Status -->
    <CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_large"
        app:cardCornerRadius="@dimen/corner_radius_large"
        app:cardElevation="@dimen/elevation_medium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textAppearance="@style/TextStyle.Subtitle"
                android:layout_marginBottom="@dimen/spacing_small" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_idle"
                android:textAppearance="@style/TextStyle.Body"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </CardView>

    <!-- Configuration -->
    <CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_large"
        app:cardCornerRadius="@dimen/corner_radius_large"
        app:cardElevation="@dimen/elevation_medium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configuration"
                android:textAppearance="@style/TextStyle.Subtitle"
                android:layout_marginBottom="@dimen/spacing_small" />

            <EditText
                android:id="@+id/targetIpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/target_ip_hint"
                android:text="203.0.113.42"
                android:inputType="text"
                android:layout_marginBottom="@dimen/spacing_small" />

            <EditText
                android:id="@+id/targetPortInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/target_port_hint"
                android:text="40001"
                android:inputType="number"
                android:layout_marginBottom="@dimen/spacing_small" />
        </LinearLayout>
    </CardView>

    <!-- Statistics -->
    <CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_large"
        app:cardCornerRadius="@dimen/corner_radius_large"
        app:cardElevation="@dimen/elevation_medium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Statistics"
                android:textAppearance="@style/TextStyle.Subtitle"
                android:layout_marginBottom="@dimen/spacing_small" />

            <TextView
                android:id="@+id/fpsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stat_fps"
                android:textAppearance="@style/TextStyle.Body"
                android:layout_marginBottom="@dimen/spacing_xsmall" />

            <TextView
                android:id="@+id/bytesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stat_bytes_sent"
                android:textAppearance="@style/TextStyle.Body"
                android:layout_marginBottom="@dimen/spacing_xsmall" />

            <TextView
                android:id="@+id/lossText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stat_packet_loss"
                android:textAppearance="@style/TextStyle.Body"
                android:layout_marginBottom="@dimen/spacing_xsmall" />

            <TextView
                android:id="@+id/uptimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stat_uptime"
                android:textAppearance="@style/TextStyle.Body" />
        </LinearLayout>
    </CardView>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:spacing="@dimen/spacing_medium">

        <Button
            android:id="@+id/startButton"
            style="@style/ButtonStyle.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="@string/start_streaming" />

        <Button
            android:id="@+id/stopButton"
            style="@style/ButtonStyle.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="@string/stop_streaming" />
    </LinearLayout>
</LinearLayout>
